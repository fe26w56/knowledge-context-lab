      "owner": "people",
      "title": "Juniper neighborhood microgrant continuity review roster",
      "body": "Emi coordinates the operation. Sora 10:00-12:30 and Tomo 12:30-15:00 cover the named shift. At least two people must be present throughout the operation, including the approved date.",
      "state": "adopted",
      "effective_from": "2026-08-11",
      "effective_to": null
