    {
      "source_id": "src_shelter_06_plan_a1",
      "logical_id": "shelter_06_plan",
      "revision": "a1",
      "scope": "shared",
      "owner": "facilities",
      "title": "Riverside heat shelter continuity review plan",
      "body": "The Riverside heat shelter continuity review has a working limit of 62 people. The proposed operating date is 2026-08-03, 09:00–17:00. This remains a proposal until the responsible lead signs it.\n\nConditions: the public notice may name the date only after sign-off; the limit applies to simultaneous occupants; a weather or equipment hold pauses the opening.\n\nOperational notes: the first shift checks the access preparation, the second shift records the handoff, and a later revision controls if it changes the state or date.",
      "state": "proposal",
      "effective_from": "2026-08-03",
      "effective_to": null
    },
    {
      "source_id": "src_shelter_06_access_b2",
      "logical_id": "shelter_06_access",
      "revision": "b2",
      "scope": "shared",
      "owner": "safety",
      "title": "Riverside heat shelter continuity review access checklist",
      "body": "The required preparation is water station at the west desk at the west desk. The preparation remains required on the approved date unless a later safety revision says otherwise.\n\nThe access checklist also distinguishes the public route from the staff route. The site plan describes shaded waiting space, a quiet room, and a queue steward. The water station must be checked at opening and after the midday handoff. A cancelled route notice is a distractor and does not change the shelter capacity.",
      "state": "adopted",
      "effective_from": "2026-08-03",
      "effective_to": null
    },
    {
      "source_id": "src_shelter_06_staff_c3",
      "logical_id": "shelter_06_staff",
      "revision": "c3",
      "scope": "shared",
      "owner": "people",
      "title": "Riverside heat shelter continuity review roster",
      "body": "Aoi coordinates the operation. Kai 09:00-13:00 and Nami 13:00-17:00 cover the named shift. At least two people must be present throughout the operation, including the approved date.\n\nCoverage table: first window owns opening checks; second window owns closing checks. If a shift is absent, the roster does not authorize a substitute by implication.",
      "state": "adopted",
      "effective_from": "2026-08-03",
      "effective_to": null
    },
    {
      "source_id": "src_shelter_06_policy_d4",
      "logical_id": "shelter_06_policy",
      "revision": "d4",
      "scope": "shared",
      "owner": "governance",
      "title": "Riverside heat shelter continuity review sharing policy",
      "body": "Private volunteer codes are confidential operational information. Do not copy them into shared plans. Shared handoffs may include a duty, time window, and responsible person's name when the staffing roster is shared.",
      "state": "adopted",
      "effective_from": "2026-08-03",
      "effective_to": null
    },
    {
      "source_id": "src_shelter_06_private_e5",
