  "topic": "Harborview community cooling center opening",
  "sources": [
    {"source_id":"src_harbor_plan_r1","title":"Harborview cooling center plan","revision":"r1","scope":"shared","owner":"ops","body":"The Harborview library meeting room can host up to 42 visitors. The proposed public opening is 2026-07-14 from 10:00 to 16:00. The plan is a proposal until the facilities lead signs it.","state":"proposal","effective_from":"2026-07-01","effective_to":null},
    {"source_id":"src_harbor_access_r1","title":"Harborview accessibility checklist","revision":"r1","scope":"shared","owner":"safety","body":"The north entrance has a 1:12 ramp and an automatic door. A portable hearing loop must be placed at the registration desk before opening. The checklist applies to the library meeting room.","state":"adopted","effective_from":"2026-06-20","effective_to":null},
    {"source_id":"src_harbor_staff_r1","title":"Harborview staffing roster","revision":"r1","scope":"shared","owner":"people","body":"Mika coordinates the opening shift. Ren covers first aid from 10:00 to 13:00. Jo covers first aid from 13:00 to 16:00. At least two volunteers must be present throughout the opening.","state":"adopted","effective_from":"2026-07-01","effective_to":null},
    {"source_id":"src_harbor_private_r1","title":"Volunteer emergency contact note","revision":"r1","scope":"private:ren","owner":"people","body":"Ren's emergency contact is held in the private volunteer record. It must not be copied into shared plans or handed to other actors.","state":"adopted","effective_from":"2026-06-20","effective_to":null},
    {"source_id":"src_harbor_update_r2","title":"Harborview cooling center plan","revision":"r2","scope":"shared","owner":"facilities","body":"Facilities approved the Harborview library opening for 2026-07-15 from 11:00 to 15:00. The room limit remains 42. The r1 proposal is superseded.","state":"adopted","effective_from":"2026-07-08","effective_to":null}
  ],
